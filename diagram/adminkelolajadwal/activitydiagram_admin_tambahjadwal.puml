@startuml ACTIVITY_DIAGRAM_ADMIN_TAMBAHJADWAL
title Activity Diagram - Admin Tambah Jadwal Donor Darah

|Admin|
start
:Buka menu Jadwal Donor;
:Klik tombol "Tambah Jadwal";

|Sistem|
:Tampilkan form tambah jadwal;

|Admin|
:Isi form (Tanggal, Waktu, Lokasi, Kuota, dll);
:Klik "Simpan";

|Sistem|
:Validasi input data jadwal;
if (Validasi sukses?) then (Ya)
  :Kirim data & Simpan ke sistem;
  :Tampilkan notifikasi berhasil;
  :Perbarui tampilan daftar jadwal;
else (Tidak)
  :Tampilkan pesan error validasi;
endif

|Admin|
stop

@enduml