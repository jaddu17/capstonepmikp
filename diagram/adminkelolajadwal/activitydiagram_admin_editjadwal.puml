@startuml ACTIVITY_DIAGRAM_ADMIN_EDITJADWAL
title Activity Diagram - Admin Edit Jadwal Donor Darah

|Admin|
start
:Buka menu Jadwal Donor;
:Klik tombol "Edit" pada salah satu jadwal;

|Sistem|
:Tampilkan form edit dengan data jadwal;

|Admin|
:Ubah data (Tanggal, Hari, Lokasi, Waktu, Kuota);

if (Klik tombol?) then (Batal)
  |Sistem|
  :Tampilkan daftar jadwal;
  |Admin|
  stop
else (Simpan)
  |Sistem|
  :Validasi input data;
  if (Validasi sukses?) then (Tidak)
    :Tampilkan pesan error;
    |Admin|
    :Perbaiki data;
    detach
  else (Ya)
    :Update data ke database;
    :Tampilkan notifikasi berhasil;
    :Perbarui daftar jadwal;
  endif
endif

|Admin|
stop

@enduml