@startuml ACTIVITY_DIAGRAM_USER_VIEW_BERITA
title Activity Diagram - User View Berita

|User|
start
:Klik menu Berita;

|Sistem|
:Navigasi ke halaman berita;

|Database|
:Query daftar berita;

|Sistem|
:Tampilkan list berita;
:Tampilkan thumbnail, judul, tanggal;

|User|
:Melihat daftar berita;
:Pilih berita dengan tombol "Baca Selengkapnya";

if (Klik "Baca Selengkapnya"?) then (Ya)
  |Sistem|
  :Tampilkan modal detail berita;

  |Database|
  :Query detail berita by ID;

  |Sistem|
  :Render modal dengan judul, konten, gambar, kategori, tanggal;

  |User|
  :Baca detail berita;
  :Scroll konten;
else (Tidak)
  stop
endif

|User|
:Selesai membaca;
if (Klik tombol "Tutup"?) then (Ya)
  |Sistem|
  :Tutup modal dan kembali ke daftar berita;
else (Tidak)
  stop
endif

|User|
stop

@enduml
