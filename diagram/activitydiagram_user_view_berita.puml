@startuml ACTIVITY_DIAGRAM_USER_VIEW_BERITA
title Activity Diagram - User View Berita

|User|
start
:Akses halaman Berita\n(Melalui menu Navbar);

|Sistem|
:Menerima permintaan rute /berita;

|Database|
:Query data seluruh berita terkini\n(Beserta konten isi lengkapnya);

|Sistem|
:Render daftar kartu berita\n(Menampilkan Thumbnail, Kategori, Judul, Tanggal);
:Tampilkan keseluruhan halaman Berita ke layar;

|User|
:Melihat dan mengeksplorasi daftar berita;

if (Pilih Aksi Selanjutnya?) then (Klik "Baca Selengkapnya")
  |Sistem|
  :Render dan tampilkan modal pop-up detail berita\n(Menggunakan data di memori tanpa query ulang);
  
  |User|
  :Membaca isi detail berita;
  :Selesai membaca, klik tombol "Tutup" (X);
  
  |Sistem|
  :Tutup modal pop-up dan\nkembali menampilkan daftar berita;
else (Hanya Scroll / Keluar)
  |User|
  :Meninggalkan halaman;
endif

|User|
stop

@enduml