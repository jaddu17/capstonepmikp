@startuml FLOWCHART
title Flowchart - Alur Utama Website PMI Kulon Progo

start
:Pengguna membuka website;
if (Admin atau Publik?) then (Admin)
  :Tampil halaman login admin;
  :Admin memasukkan username/password;
  if (Login valid?) then (Ya)
    :Masuk dashboard admin;
    if (Pilih kelola stok darah?) then (Ya)
      :Admin mengelola stok darah;
    else (Tidak)
    endif
    if (Pilih kelola jadwal?) then (Ya)
      :Admin mengelola jadwal donor;
    else (Tidak)
    endif
    if (Pilih kelola berita?) then (Ya)
      :Admin mengelola berita;
    else (Tidak)
    endif
    if (Pilih kelola donasi?) then (Ya)
      :Admin memantau donasi publik;
    else (Tidak)
    endif
    if (Pilih kelola pesan?) then (Ya)
      :Admin membalas pesan;
    else (Tidak)
    endif
    stop
  else (Tidak)
    :Tampilkan error login;
    stop
  endif
else (Publik)
  :Tampil halaman utama;
  if (Lihat berita?) then (Ya)
    :Pengguna membaca berita;
  else (Tidak)
  endif
  if (Lihat stok darah?) then (Ya)
    :Pengguna melihat stok darah;
  else (Tidak)
  endif
  if (Lihat jadwal donor?) then (Ya)
    :Pengguna melihat jadwal donor;
  else (Tidak)
  endif
  if (Isi form donasi?) then (Ya)
    :Pengguna mengirim donasi;
  else (Tidak)
  endif
  if (Kirim pesan kontak?) then (Ya)
    :Pengguna mengirim pesan ke PMI;
  else (Tidak)
  endif
  stop
endif

@enduml