@startuml FLOWCHART
title Flowchart - Alur Navigasi Website PMI Kulon Progo

start
:Pengguna membuka website;
:Render Home page;
if (Klik "Cek Stok Darah"?) then (Ya)
  :Navigasi ke halaman /stok-darah;
  :Tampilkan Stok Darah Real-Time;
  :Tampilkan kartu jenis darah dan status;
  if (Klik "Lihat Syarat & Cara Donor"?) then (Ya)
    :Scroll ke bagian Prosedur Permintaan Darah;
  endif
  stop
else (Tidak)
  if (Klik "Jadwal Donor"?) then (Ya)
    :Navigasi ke halaman /jadwal;
    :Tampilkan daftar jadwal donor;
    :Tampilkan tombol Daftar;
    stop
  else (Tidak)
    if (Klik menu lain?) then (Berita)
      :Navigasi ke halaman /berita;
      stop
    else (Donasi)
      :Navigasi ke halaman /donasi;
      stop
    endif
  endif
endif

@enduml