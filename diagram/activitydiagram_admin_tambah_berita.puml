@startuml ACTIVITY_DIAGRAM_ADMIN_TAMBAH_BERITA
title Activity Diagram - Admin Tambah Berita

|Admin|
start
:Buka menu Berita;
:Klik tombol "Tambah Berita";

|Sistem|
:Tampilkan form tambah berita;

|Admin|
:Isi form (Judul, Konten, Gambar, Kategori, dll);
:Klik "Simpan";

|Sistem|
:Validasi input data berita;
if (Validasi sukses?) then (Ya)
  :Kirim data & Simpan ke sistem;
  :Tampilkan notifikasi berhasil;
  :Perbarui tampilan daftar berita;
else (Tidak)
  :Tampilkan pesan error validasi;
endif

|Admin|
stop

@enduml
