@startuml ACTIVITY_DIAGRAM_ADMIN_HAPUS_PESAN
title Activity Diagram - Admin Hapus Pesan

|Admin|
start
:Buka menu Pesan Masuk;
:Klik tombol "Hapus" pada salah satu pesan;

|Sistem|
:Tampilkan dialog konfirmasi penghapusan;

|Admin|
if (Yakin hapus?) then (Ya)
  :Klik "Konfirmasi / Hapus";

  |Sistem|
  :Hapus data dari sistem;
  :Tampilkan notifikasi berhasil dihapus;
else (Batal)
  |Admin|
  :Klik "Batal";
endif

|Admin|
stop

@enduml
