@startuml ACTIVITY_DIAGRAM_ADMIN_EDIT_BERITA
title Activity Diagram - Admin Edit Berita

|Admin|
start
:Buka halaman Kelola Berita;
:Melihat daftar kartu berita;
:Klik icon "Edit" pada salah satu berita;

|Sistem|
:Tampilkan form Edit Berita dengan data terisi;

|Admin|
:Ubah data form (Judul, Kategori, Isi, dll);
:Klik tombol "Simpan";

|Sistem|
:Validasi form;
if (Validasi sukses?) then (Ya)
  |Database|
  :Update data berita;
  |Sistem|
  :Sembunyikan form;
  :Tampilkan notifikasi "Berita berhasil diperbarui!";
  :Perbarui daftar kartu berita;
else (Tidak)
  |Sistem|
  :Tampilkan pesan error;
  |Admin|
  :Perbaiki input form;
  stop
endif

stop

@enduml
