|Sistem|
if (Data lengkap?) then (Ya)
    :Simpan foto dokumentasi;
    :Simpan data kontak;
    :Simpan data statistik layanan;
    :Simpan daftar pelayanan;
    :Simpan quote;
    :Perbarui data infografis
    bulan terpilih;
    :Tampilkan notifikasi berhasil;
else (Tidak)
    :Tampilkan pesan kesalahan;
endif

|Admin|
