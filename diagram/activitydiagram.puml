@startuml
partition "Pengunjung" {
  start
  :Open Website Home;
  if (Pilih menu?) then (Ya)
    :Pilih halaman;
    fork
      :Lihat Stok Darah;
    fork again
      :Lihat Jadwal Donor;
    fork again
      :Lihat Berita;
    fork again
      :Lihat Info Donor / Prosedur;
    end fork
    if (Ingin donasi?) then (Ya)
      :Buka Halaman Donasi;
      :Isi Form Donasi / Kirim Info;
      :Tampilkan notifikasi sukses;
    endif
    if (Ingin kontak?) then (Ya)
      :Buka Halaman Kontak;
      :Kirim Pesan / Kontak PMI;
      :Tampilkan alert "Pesan terkirim";
    endif
  else
    :Tetap di Home;
  endif
  stop
}

partition "Administrator" {
  start
  :Masuk ke /admin/login;
  :Masukkan username dan password;
  if (Login berhasil?) then (Ya)
    :Masuk dashboard admin;
    repeat
      if (Kelola Stok Darah?) then (Ya)
        :Update data stok darah;
      endif
      if (Kelola Jadwal?) then (Ya)
        :Tambah / Edit / Hapus jadwal donor;
      endif
      if (Kelola Berita?) then (Ya)
        :Tambah / Edit / Publish berita;
      endif
      if (Kelola Donasi?) then (Ya)
        :Lihat / Update / Hapus data donasi;
      endif
      if (Kelola Pesan?) then (Ya)
        :Lihat / Balas / Hapus pesan masuk;
      endif
      if (Kelola Infografis / Kontak?) then (Ya)
        :Update data infografis dan kontak;
      endif
      :Pilih tindakan lain?;
    repeat while (Ya)
    :Logout;
  else
    :Tampilkan error "Username atau password salah";
  endif
  stop
}
@enduml