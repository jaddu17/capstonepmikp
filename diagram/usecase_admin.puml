@startuml
left to right direction
skinparam packageStyle rectangle

actor "Administrator (Admin)" as Admin

package "PMI Kulon Progo Website - Admin" {
  usecase "Login" as UC_Login
  usecase "Melihat Dashboard" as UC_Dashboard
  usecase "Mengelola Stok Darah (Update)" as UC_ManageStock
  usecase "Mengelola Jadwal Donor (CRUD)" as UC_ManageJadwal
  usecase "Mengelola Berita (CRUD)" as UC_ManageNews
  usecase "Mengelola Pesan Masuk (View/Reply/Delete)" as UC_ManagePesan
  usecase "Mengelola Infografis (CRUD)" as UC_ManageInfo
  usecase "Mengelola Donasi Masuk (View/Delete)" as UC_ManageDonasi
  usecase "Logout" as UC_Logout
}

Admin --> UC_Login

UC_Login --> UC_Dashboard
UC_Login --> UC_ManageStock
UC_Login --> UC_ManageJadwal
UC_Login --> UC_ManageNews
UC_Login --> UC_ManagePesan
UC_Login --> UC_ManageInfo
UC_Login --> UC_ManageDonasi
UC_Login --> UC_Logout

@enduml
