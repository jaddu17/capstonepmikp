@startuml ACTIVITY_DIAGRAM_USER_HOME
title Activity Diagram - User Beranda / Home

|User|
start
:Akses website (Halaman Beranda);

|Sistem|
:Permintaan data Beranda;

|Database|
:Query data Tentang PMI (Visi, Misi, dsb);
:Query data Infografis Kinerja 
(Kontak Darurat, Statistik, Dokumentasi);

|Sistem|
:Render Hero Section (Tombol Cek Stok & Jadwal);
:Render bagian Tentang PMI Kulon Progo;
:Render bagian Infografis Kinerja Bulanan;
:Tampilkan keseluruhan halaman Beranda;

|User|
:Eksplorasi konten Beranda;

if (Pilih navigasi/aksi?) then (Klik Tombol Akses Cepat)
  :Klik "Cek Stok Darah" atau "Jadwal Donor";
  |Sistem|
  :Arahkan ke halaman terkait;
else if (Klik Menu Navbar)
  |User|
  :Pilih menu (Berita/Stok/Jadwal/Donasi/dll);
  |Sistem|
  :Arahkan ke halaman yang dipilih;
else (Scroll Halaman)
  |User|
  :Melihat visi misi, kontak darurat, 
  dan dokumentasi infografis;
endif

|User|
stop

@enduml
