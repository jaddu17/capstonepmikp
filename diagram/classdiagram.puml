@startuml classdiagram
skinparam classBackgroundColor #FEFEFE
skinparam classBorderColor #000000
skinparam arrowColor #000000
skinparam shadowing false
hide methods

class User {
  - id: bigint
  - name: varchar
  - email: varchar
  - email_verified_at: timestamp
  - password: varchar
  - remember_token: varchar
  - role: varchar = "admin"
  - created_at: timestamp
  - updated_at: timestamp
}

class Berita {
  - id: bigint
  - title: varchar
  - date: varchar
  - category: varchar
  - excerpt: text
  - content: text
  - image: text
  - published: boolean
  - created_at: timestamp
  - updated_at: timestamp
}

class StokDarah {
  - id: bigint
  - type: varchar
  - wb: int
  - prc: int
  - tc: int
  - status: varchar
  - created_at: timestamp
  - updated_at: timestamp
}

class JadwalDonor {
  - id: bigint
  - date: varchar
  - day: varchar
  - location: varchar
  - time: varchar
  - quota: varchar
  - created_at: timestamp
  - updated_at: timestamp
}

class Donasi {
  - id: bigint
  - nama: varchar
  - wa: varchar
  - keterangan: text
  - proof: text
  - date: varchar
  - status: varchar
  - created_at: timestamp
  - updated_at: timestamp
}

class Pesan {
  - id: bigint
  - name: varchar
  - email: varchar
  - phone: varchar
  - message: text
  - date: varchar
  - read: boolean
  - replied: boolean
  - reply_text: text
  - created_at: timestamp
  - updated_at: timestamp
}

class Infografis {
  - id: bigint
  - bulan: varchar
  - tahun: varchar
  - kontak: json
  - stats: json
  - dokumentasi: json
  - pelayanan: json
  - quote: text
  - created_at: timestamp
  - updated_at: timestamp
}

@enduml
