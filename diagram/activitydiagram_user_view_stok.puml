@startuml ACTIVITY_DIAGRAM_USER_VIEW_STOK
title Activity Diagram - User View Stok Darah

|User|
start
:Akses halaman Stok Darah\n(Melalui tombol Hero atau Menu Navbar);

|Sistem|
:Menerima permintaan route /stok-darah;

|Database|
:Query data stok darah terkini;

|Sistem|
:Render 8 kartu stok darah\n(Menampilkan Golongan, Kuantitas, Status);
:Render bagian Syarat & Prosedur Permintaan Darah;
:Tampilkan keseluruhan halaman Stok Darah ke layar;

|User|
:Melihat informasi stok darah real-time;

if (Pilih Aksi Selanjutnya?) then (Klik "Lihat Syarat & Cara Permintaan")
  |Sistem|
  :Scroll otomatis ke bagian ID #prosedur;
  |User|
  :Membaca prosedur permintaan darah;
else if (Klik "Hubungi via WhatsApp")
  |Sistem|
  :Buka tautan WhatsApp Admin PMI;
  |User|
  :Meneruskan pesan permintaan stok darah;
else (Hanya Scroll / Keluar)
  |User|
  :Eksplorasi manual atau meninggalkan halaman;
endif

|User|
stop

@enduml