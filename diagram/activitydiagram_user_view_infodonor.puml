@startuml ACTIVITY_DIAGRAM_USER_VIEW_INFODONOR
title Activity Diagram - User View Info Donor

|User|
start
:Klik menu "Info Donor" di header atau navigasi ke /info-donor;

|Sistem|
:Render halaman Info Donor;

|Sistem|
:Render section "Syarat-Syarat Donor Darah";

|Database|
:Ambil data syarat donor dan alur pendaftaran;

|Sistem|
:Tampilkan daftar syarat donor darah;
:Tampilkan catatan penting di panel kuning;

|User|
:Scroll dan baca syarat donor;

if (Butuh info pendaftaran?) then (Ya)
  |Sistem|
  :Render daftar alur pendaftaran;
  :Tampilkan 6 langkah donor darah;
  
  |User|
  :Baca alur pendaftaran;
else (Tidak)
  stop
endif

|User|
if (Klik "Lihat Jadwal Donor"?) then (Ya)
  |Sistem|
  :Scroll ke section Jadwal di halaman /info-donor (anchor #jadwal);
  stop
else (Tidak)
  if (Klik "Hubungi Kami"?) then (Ya)
    |Sistem|
    :Scroll ke section Kontak di halaman /info-donor (anchor #kontak);
    stop
  else (Tidak)
    stop
  endif
endif

@enduml