@startuml ACTIVITY_DIAGRAM_ADMIN_MANAGE_JADWAL
title Activity Diagram - Admin Manage Jadwal Donor

|Admin|
start
:Mengakses menu Jadwal Donor;

|Sistem|
:Menampilkan daftar jadwal donor;

|Admin|
:Memilih aksi kelola (Tambah/Edit/Hapus);
if (Aksi Kelola?) then (Ya)
  :Mengisi form data jadwal;
else (Tidak)
  stop
endif

|Sistem|
:Memvalidasi kelengkapan dan konflik jadwal;

if (Data valid?) then (Ya)
  :Menyimpan data jadwal ke database;
  :Menampilkan pesan sukses;
else (Tidak)
  :Menampilkan pesan peringatan;
  stop
endif

|Admin|
stop

@enduml
