@startuml ACTIVITY_DIAGRAM_USER_VIEW_DONASI_FINAL
title Activity Diagram - User Melakukan Donasi

|User|
start
:Akses halaman Donasi;

|Sistem|
:Render halaman donasi\n(Formulir Donasi Uang & Info Donasi Barang);

|User|
:Mengeksplorasi pilihan jenis donasi;

if (Pilih jenis donasi?) then (Donasi Barang/Logistik)
  :Klik tombol "Hubungi Markas";
  
  |Sistem|
  :Arahkan rute ke halaman Kontak (/kontak);
  
  |User|
  :Melihat informasi kontak markas;
  stop

else (Donasi Uang)
  |User|
  :Mengisi form donasi uang\n(Nama, No. WA, Keterangan);
  :Klik tombol "Lanjut ke Pembayaran QRIS";
  
  |Sistem|
  :Generate ID Donasi sementara;
  :Simpan data donasi\n(Status: "Menunggu Pembayaran");
  :Tampilkan kode QRIS dan form unggah bukti;
  
  |User|
  :Scan QRIS dan transfer dana;
  
  repeat
    |User|
    :Unggah bukti transfer;
    :Klik tombol "Konfirmasi Pembayaran";
    |Sistem|
  repeat while (Validasi: Bukti terunggah?) is (Belum / Kosong)
  ->Sudah (Valid);

  |Sistem|
  :Perbarui data donasi\n(Simpan bukti, Status: "Sudah Bayar");
  :Tampilkan notifikasi sukses;
  
  |User|
  :Klik tombol "Kembali ke Beranda";
  
  |Sistem|
  :Arahkan rute ke halaman utama (/);
  stop
endif

@enduml