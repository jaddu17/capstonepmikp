@startuml ACTIVITY_DIAGRAM_ADMIN_MANAGE_STOK
title Activity Diagram - Admin Manage Stok Darah

|Admin|
start
:Buka halaman Kelola Stok Darah;

|Sistem|
:Ambil data stok (WB, PRC, TC) terbaru;
:Tampilkan form stok darah;

|Admin|
:Ubah jumlah WB, PRC, atau TC;

|Sistem|
:Hitung total (WB + PRC);
if (Golongan Darah?) then (AB)
  :Status otomatis: <= 10 (STOK KURANG),\n> 10 (STOK CUKUP);
else (A, B, O)
  :Status otomatis: <= 30 (STOK KURANG),\n> 30 (STOK CUKUP);
endif
:Tampilkan perubahan status secara realtime;

|Admin|
:Klik tombol "Simpan Perubahan";

|Sistem|
:Kirim data update (Bulk Update);
if (Simpan Berhasil?) then (Ya)
  :Tampilkan notifikasi sukses;
else (Tidak)
  :Tampilkan notifikasi error;
endif

|Admin|
stop

@enduml
