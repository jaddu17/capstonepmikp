@startuml ACTIVITY_DIAGRAM_ADMIN_MANAGE_STOK
title Activity Diagram - Admin Manage Stok Darah

|Admin|
start
:Buka halaman Stok Darah;

|Sistem|
:Tampilkan form kartu golongan darah
dengan jumlah kantong dan status saat ini;

|Admin|
:Klik tambah/kurangi jumlah pada
kartu golongan darah tertentu;
:Klik tombol "Simpan Perubahan";

|Sistem|
:Terima data perubahan stok;
:Tentukan status baru otomatis
(>20: Aman, 10-19: Menipis, <10: Kritis);
:Validasi data;

|Database|
if (Validasi sukses?) then (Ya)
  :Update stok darah dan status ke database;
else (Tidak)
  |Sistem|
  :Tampilkan pesan error;
  stop
endif

|Sistem|
:Tampilkan notifikasi sukses;
:Perbarui tampilan kartu stok darah;

|Admin|
stop

@enduml
