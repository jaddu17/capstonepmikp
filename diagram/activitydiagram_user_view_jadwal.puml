@startuml ACTIVITY_DIAGRAM_USER_VIEW_JADWAL
title Activity Diagram - User View Jadwal Donor

|User|
start
:Klik menu "Jadwal Donor" di header atau tombol "Jadwal Donor";

|Sistem|
:Navigasi ke route /jadwal;

|Database|
:Query jadwal donor;

|Sistem|
:Render halaman Jadwal Donor;
:Tampilkan daftar jadwal mobile unit;
:Menampilkan:
- Tanggal acara;
- Hari;
- Lokasi;
- Jam;
- Kuota;
- Tombol Daftar;

|User|
:Melihat jadwal donor;
:Pilih jadwal yang diinginkan;

if (Klik tombol "Daftar"?) then (Ya)
  |Sistem|
  :Buka link WhatsApp dengan pesan prafilled;
  :Arahkan user ke WhatsApp;

  |User|
  :Kirim pesan pendaftaran donor;
  stop
else (Tidak)
  |User|
  :Lihat detail jadwal lain atau kembali;
  stop
endif

@enduml
