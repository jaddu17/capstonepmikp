@startuml ACTIVITY_DIAGRAM_USER_VIEW_JADWAL
title Activity Diagram - User View Jadwal Donor

|User|
start
:Akses halaman Jadwal Donor\n(Melalui menu Navbar atau tombol di Beranda);

|Sistem|
:Menerima permintaan rute /jadwal;
:Ambil data jadwal donor (Mobile Unit) terkini;
:Render daftar kartu jadwal donor\n(Menampilkan Tanggal, Hari, Lokasi, Jam, dan Kuota);
:Tampilkan keseluruhan halaman Jadwal Donor ke layar;

|User|
:Melihat informasi dan mengeksplorasi\njadwal donor yang tersedia;

if (Pilih Aksi Selanjutnya?) then (Klik Tombol "Daftar")
  |Sistem|
  :Buka tautan WhatsApp Admin PMI\ndengan pesan templat otomatis;
  |User|
  :Meneruskan pesan pendaftaran\ndonor darah via WhatsApp;
else (Hanya Scroll / Keluar)
  |User|
  :Melihat detail jadwal lain\natau meninggalkan halaman;
endif

|User|
stop

@enduml