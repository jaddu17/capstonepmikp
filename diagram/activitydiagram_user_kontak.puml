@startuml ACTIVITY_DIAGRAM_USER_KONTAK
title Activity Diagram - Kontak & Kirim Pesan

start
:User akses halaman Kontak;
:Sistem tampilkan halaman Kontak;
:User pilih metode kontak;

switch (Metode?)
case ()
    :**WhatsApp**;
    :Sistem buka aplikasi WhatsApp;
    :User kirim pesan via WhatsApp;
    :Tampilkan status terkirim;

case ()
    :**Email**;
    :Sistem buka aplikasi Email;
    :User kirim Email;
    :Tampilkan status terkirim;

case ()
    :**Form Pesan**;
    repeat
        :User isi Form Pesan;
        :User klik "Kirim";
        :Sistem validasi input;
    repeat while (Input valid?) is (Tidak)
    ->Ya;
    :Sistem simpan pesan;
    :Tampilkan notifikasi berhasil;

endswitch

stop
@enduml