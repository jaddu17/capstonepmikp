@startuml ACTIVITY_DIAGRAM_USER_KONTAK_REVISI
title Activity Diagram - User View Kontak & Interaksi

|User|
start
:Akses halaman Kontak;

|Sistem|
:Menerima permintaan rute /kontak;
:Render halaman Kontak secara utuh\n(Informasi Kontak & Formulir Pesan);

|User|
if (Pilih Tindakan / Interaksi?) then (Klik Hubungi via WhatsApp)
  |Sistem|
  :Buka aplikasi / tautan WhatsApp PMI;
  |User|
  :Melanjutkan komunikasi langsung via WhatsApp;
  stop

else if (Klik Alamat Email)
  |Sistem|
  :Buka aplikasi klien email (mailto:);
  |User|
  :Melanjutkan penulisan email manual;
  stop

else if (Kirim Pesan via Formulir)
  repeat
    |User|
    :Mengisi form pesan\n(Nama, Email, Subjek, Pesan);
    :Klik tombol "Kirim Pesan";
    
    |Sistem|
  repeat while (Validasi Input Form?) is (Tidak Valid / Kosong)
  ->Valid;
  
  |Sistem|
  :Simpan data pesan baru ke dalam sistem;
  :Tampilkan notifikasi sukses "Pesan terkirim";
  |User|
  :Membaca notifikasi sukses;
  stop

else (Hanya Melihat Info / Keluar)
  |User|
  :Meninggalkan halaman Kontak;
  stop
endif

@enduml